  "platform_notes": {
    "active_only_enumeration": "debug_trace_catalog refresh lists ACTIVE files only via `ls -1 /core/traces/<c> | grep -v .gz`. The read-only guard allows `|`+`grep` but rejects ; && || and the chars > < ` $, so the pattern must avoid `$` (use '\\.gz', not '\\.gz$'). Active-only keeps output small so a busy dir's 120+ rotated archives never overflow the component-shell scrollback and truncate the active-file head.",
    "rotation_classification": "Refresh reclassifies a catalog entry whose active file is absent: if `<base>-*.gz` archives exist it is rotated_only (evidence lives in the newest archive); if only connection artifacts like dbclient-<base>-* / dn_conn-<base>-* exist it is truly absent (wrong base name for the platform). Exact-prefix match `<base>-` is required so dbclient-cli is not mistaken for cli.",
    "cl86_cluster_ncc": "On CL-86 and disaggregated clusters the routing-engine is on a separate NCC. `ls /core/traces/routing_engine` on the default (NCP) component is nearly empty. debug_trace_catalog auto-detects this (routing_engine <15 active AND bgpd+fibmgrd+rib-manager+isisd+rsvpd+ldpd all absent) and returns platform_hint telling the caller to re-run with ncc_id=<active-ncc>.",
    "datapath_ncp": "datapath container is on the NCP; pass ncp_id for a specific NCP, otherwise the first operationally-up NCP is used."
  },
  "listing_grammar": {
    "primary": "backend component shell: ls -1 /core/traces/<container> | grep -v .gz  (active-only, bounded, scrollback-safe)",
    "active_only_rationale": "grep -v .gz drops rotated archives ON THE DEVICE so a busy dir (120+ .gz) does not push the active-file head off the component-shell scrollback. Archives are listed lazily per-base with `ls -1 <dir> | grep <base>-` only when rotation resolution needs them.",
    "single_box": "component_type=ncc for control containers; component_type=ncp for datapath",
    "cluster": "pass ncc_id/ncp_id -> debug_trace_catalog runs ls on that specific node's component shell; CL-86 routing-engine REQUIRES ncc_id",
    "cli_list_not_supported": "show file traces <container>/ list -> 'Unknown word: list' on DNOS 26.2.0 (PE-1) and CL-86 (PE-4). 'show file traces list' (file_type form per cmd_search) DUMPS full content (~19MB/2min) on CL-86 -- never use it for enumeration.",
    "safety_guard": "debug_trace_catalog rejects any listing output >1500 lines or log-line dense (prevents ingesting a content dump).",
    "rotation": "rotated history = <base>-YYYYMMDD_HH:MM:SS.gz under the same dir; active tail = bare <base>. The archive whose stamp is the smallest >= target-time contains entries at that time."
  },
