{
  "name": "igmp-snooping-l2",
  "protocol": "igmp",
  "scale": "small",
  "summary": "Layer-2 IGMP snooping on an access switch. Without snooping the switch floods multicast to every port; with snooping it listens to IGMP Joins/Leaves and only forwards to interested ports. Upstream mrouter port discovered via IGMP queries.",
  "tags": [
    "multicast",
    "igmp",
    "igmpv3",
    "snooping",
    "l2",
    "access",
    "bum",
    "querier"
  ],
