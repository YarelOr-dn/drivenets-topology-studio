{
  "name": "mldp-p2mp-tree",
  "protocol": "mldp",
  "scale": "medium",
  "summary": "Multicast LDP (mLDP) P2MP LSP tree. Root PE (ingress) signals a Point-to-Multipoint LSP via FEC advertisement; P routers replicate; leaf PEs terminate. Used as the transport tunnel for MVPN or IPTV multicast in MPLS networks. No PIM in the core.",
  "tags": [
    "multicast",
    "mldp",
    "p2mp",
    "mpls",
    "lsp",
    "ldp",
    "tree",
    "rfc6388",
    "mvpn-transport"
  ],
